# Supabase (obligatorias)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Secreto para autorizar POST /api/revalidar (header: Authorization: Bearer <valor>)
REVALIDATION_SECRET=


# URL pública del sitio (sin barra final). Se usa para metadataBase,
# robots.txt y sitemap.xml. En Vercel, si se omite, cae automáticamente a
# la URL del deploy.
NEXT_PUBLIC_SITE_URL=https://lebaux.com.ar

# Sentry (monitoreo de errores). El DSN es público a propósito (así
# funciona Sentry: identifica el proyecto, no es un secreto). Sin esta
# variable, Sentry.init() simplemente no hace nada.
NEXT_PUBLIC_SENTRY_DSN=

# Estas 3 son opcionales: solo hacen falta para que el build suba source
# maps a Sentry y los stack traces se vean con el código real en vez de
# minificado. SENTRY_AUTH_TOKEN es secreto, no lo comitees.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
